{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halo",
  "version": "0.1.0",
  "identifier": "app.halo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/halo/?desktop=1",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Halo",
        "url": "index.html?desktop=1",
        "width": 224,
        "height": 34,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://brqrszaljxeduelpuyty.supabase.co; connect-src 'self' ipc: http://ipc.localhost https://brqrszaljxeduelpuyty.supabase.co wss://brqrszaljxeduelpuyty.supabase.co https://api.open-meteo.com https://geocoding-api.open-meteo.com; object-src 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "halo"
        ]
      }
    }
  }
}

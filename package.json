{
  "name": "halo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Halo: a personal Dynamic Island layer for NotchPixel, plus an iPhone PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "icons": "node scripts/icons.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:home": "node scripts/shots-home.mjs",
    "shots:embed": "node scripts/shots-embed.mjs",
    "shots:card15": "node scripts/shots-card15.mjs",
    "shots:card15b": "node scripts/shots-card15b.mjs",
    "shots:phone": "node scripts/shots-phone.mjs",
    "test:home": "node scripts/test-home.mjs",
    "record": "node scripts/record.mjs",
    "shots:study": "node scripts/shots-study.mjs",
    "shots:legacy": "node scripts/shots-legacy.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "check:overflow": "node scripts/check-overflow.mjs",
    "shots:card16": "node scripts/shots-card16.mjs",
    "test:card16": "node scripts/test-card16.mjs",
    "shots:card18": "node scripts/shots-card18.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "desktop:dev": "npm run helper:build && tauri dev --config desktop/src-tauri/tauri.dev.conf.json",
    "desktop:build": "npm run helper:build && tauri build",
    "tauri": "tauri",
    "test:desktop": "cargo test --manifest-path desktop/src-tauri/Cargo.toml",
    "shots:card25": "node scripts/shots-card25.mjs",
    "helper:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "test:helper": "helper/.build-venv/Scripts/python.exe -m pytest helper/tests -q",
    "shots:card26": "node scripts/shots-card26.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tauri-apps/cli": "^2.12.6",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
